{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "useTabs": false,
  "tabWidth": 2,
  "printWidth": 80,
  "singleQuote": false,
  "jsxSingleQuote": false,
  "quoteProps": "as-needed",
  "trailingComma": "all",
  "semi": true,
  "arrowParens": "always",
  "bracketSameLine": false,
  "bracketSpacing": true,
  "ignorePatterns": [
    "node_modules",
    ".next",
    "dist",
    "build",
    "coverage",
    "out",
    ".source",
    "drizzle-d1",
    "content",
    "src/components/ui",
    "src/components/auth",
    "src/lib/auth",
    "postcss.config.mjs",
    "src/routeTree.gen.ts",
    "public/sf-openapi.json"
  ]
}
