# Prerendered pages and static files skip the Worker, so they need the same
# security headers as src/server.ts.
/*
  X-Frame-Options: SAMEORIGIN
  Content-Security-Policy: frame-ancestors 'self'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), usb=(), serial=(), hid=(), browsing-topics=()
  Cross-Origin-Opener-Policy: same-origin-allow-popups

/api/search
  Content-Type: application/json; charset=utf-8

/api/search-index/*
  Content-Type: application/json; charset=utf-8

/_images/*
  Cache-Control: public, max-age=31536000, immutable

# Vite emits content-hashed bundles here.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Unhashed file copied from public/assets keeps the revalidating default.
/assets/powered-by-vercel.svg
  ! Cache-Control
