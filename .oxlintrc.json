{
  "$schema": "./node_modules/@effect/tsgo/oxlint-schema.json",
  "extends": ["./node_modules/@effect/tsgo/oxlint-presets/strict.json"],
  "plugins": [
    "typescript",
    "unicorn",
    "oxc",
    "import",
    "promise",
    "react",
    "jsx-a11y",
    "node",
    "effecttsgo"
  ],
  "jsPlugins": ["@shadcn/lint", "eslint-plugin-better-tailwindcss"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error",
    "pedantic": "error"
  },
  "options": {
    "typeAware": true,
    "typeCheck": true,
    "denyWarnings": true,
    "reportUnusedDisableDirectives": "error"
  },
  "env": {
    "builtin": true,
    "browser": true,
    "node": true
  },
  "ignorePatterns": [
    "src/components/ui/**",
    "src/components/auth/**",
    "src/lib/auth/**",
    "src/components/data-table/**",
    "src/routeTree.gen.ts"
  ],
  "rules": {
    "better-tailwindcss/enforce-canonical-classes": "error",
    "better-tailwindcss/no-conflicting-classes": "error",
    "better-tailwindcss/no-deprecated-classes": "error",
    "better-tailwindcss/no-duplicate-classes": "error",
    "effecttsgo/any-unknown-in-error-context": "off",
    "effecttsgo/strict-effect-provide": "off",
    "effecttsgo/unsafe-effect-type-assertion": "off",
    "eslint/array-callback-return": "error",
    "eslint/eqeqeq": [
      "error",
      "always",
      {
        "null": "ignore"
      }
    ],
    "eslint/no-await-in-loop": "off",
    "eslint/no-console": "error",
    "eslint/no-fallthrough": "error",
    "eslint/no-loop-func": "error",
    "eslint/no-promise-executor-return": "error",
    "eslint/no-self-compare": "error",
    "eslint/no-shadow": "error",
    "eslint/no-throw-literal": "error",
    "eslint/no-underscore-dangle": [
      "error",
      {
        "allow": ["_tag", "_splat", "_notFound"]
      }
    ],
    "eslint/no-useless-call": "error",
    "import/no-cycle": "error",
    "import/no-duplicates": "error",
    "import/no-unassigned-import": [
      "error",
      {
        "allow": ["**/*.css", "@fontsource-variable/**"]
      }
    ],
    "jsx-a11y/alt-text": "error",
    "jsx-a11y/anchor-has-content": "error",
    "jsx-a11y/no-autofocus": [
      "error",
      {
        "ignoreNonDOM": true
      }
    ],
    "jsx-a11y/prefer-tag-over-role": "error",
    "oxc/no-accumulating-spread": "error",
    "promise/always-return": [
      "error",
      {
        "ignoreLastCallback": true
      }
    ],
    "promise/catch-or-return": "error",
    "promise/no-promise-in-callback": "error",
    "react-hooks/exhaustive-deps": "error",
    "react/button-has-type": "error",
    "react/exhaustive-effect-dependencies": "error",
    "react/iframe-missing-sandbox": "error",
    "react/jsx-no-constructed-context-values": "error",
    "react/jsx-no-target-blank": "error",
    "react/jsx-no-useless-fragment": "error",
    "react/no-array-index-key": "error",
    "react/no-children-prop": "error",
    "react/no-danger": "error",
    "react/no-deriving-state-in-effects": "error",
    "react/no-object-type-as-default-prop": "error",
    "react/no-unknown-property": "error",
    "react/no-unstable-nested-components": [
      "error",
      {
        "allowAsProps": true
      }
    ],
    "react/only-export-components": "error",
    "react/purity": "error",
    "react/react-in-jsx-scope": "off",
    "react/set-state-in-effect": "error",
    "typescript/ban-ts-comment": [
      "error",
      {
        "ts-expect-error": "allow-with-description",
        "ts-ignore": true,
        "ts-nocheck": true,
        "ts-check": false,
        "minimumDescriptionLength": 10
      }
    ],
    "typescript/consistent-return": "error",
    "typescript/consistent-type-exports": "error",
    "typescript/consistent-type-imports": "error",
    "typescript/no-deprecated": "error",
    "typescript/no-explicit-any": "error",
    "typescript/no-floating-promises": [
      "error",
      {
        "allowForKnownSafeCalls": [
          {
            "from": "package",
            "package": "node:test",
            "name": [
              "test",
              "describe",
              "it",
              "suite",
              "before",
              "after",
              "beforeEach",
              "afterEach"
            ]
          }
        ]
      }
    ],
    "typescript/no-misused-promises": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/no-unnecessary-condition": [
      "error",
      {
        "allowConstantLoopConditions": "only-allowed-literals"
      }
    ],
    "typescript/no-unnecessary-template-expression": "error",
    "typescript/no-unnecessary-type-arguments": "error",
    "typescript/no-unnecessary-type-assertion": "error",
    "typescript/no-unnecessary-type-parameters": "error",
    "typescript/no-unsafe-enum-assignment": "error",
    "typescript/no-unsafe-type-assertion": "error",
    "typescript/no-useless-empty-export": "error",
    "typescript/only-throw-error": [
      "error",
      {
        "allow": [
          {
            "from": "package",
            "package": "@tanstack/router-core",
            "name": ["Redirect", "NotFoundError"]
          }
        ]
      }
    ],
    "typescript/prefer-nullish-coalescing": [
      "error",
      {
        "ignorePrimitives": {
          "string": true,
          "boolean": true
        }
      }
    ],
    "typescript/prefer-optional-chain": "error",
    "typescript/prefer-promise-reject-errors": "error",
    "typescript/prefer-readonly": "error",
    "typescript/prefer-reduce-type-parameter": "error",
    "typescript/prefer-ts-expect-error": "error",
    "typescript/require-await": "error",
    "typescript/restrict-plus-operands": "error",
    "typescript/restrict-template-expressions": "error",
    "typescript/return-await": "error",
    "typescript/switch-exhaustiveness-check": "error",
    "unicorn/consistent-function-scoping": "error",
    "unicorn/no-abusive-eslint-disable": "error",
    "unicorn/no-array-reverse": "error",
    "unicorn/no-array-sort": "error",
    "unicorn/prefer-array-find": "error",
    "unicorn/prefer-array-flat-map": "error",
    "unicorn/prefer-at": "error",
    "unicorn/prefer-node-protocol": "error",
    "unicorn/prefer-set-has": "error",
    "unicorn/prefer-string-replace-all": "error",
    "unicorn/prefer-top-level-await": "error",
    "shadcn/no-arbitrary-values": [
      "error",
      {
        "allow": [
          "layout",
          "shadow-[inset_0_1px_0_rgba(255,255,255,0.04)]",
          "bg-[#1a1a2e]",
          "bg-[#222232]"
        ]
      }
    ],
    "shadcn/no-inline-styles": "error",
    "shadcn/no-raw-colors": [
      "error",
      {
        "allow": [
          "*-fd-*",
          "bg-zinc-950",
          "bg-zinc-200",
          "border-zinc-800",
          "text-zinc-950",
          "text-zinc-50",
          "text-zinc-400",
          "text-zinc-300",
          "bg-rose-500/18",
          "bg-rose-400/18",
          "bg-orange-400/18",
          "bg-orange-300/12",
          "bg-amber-400/70",
          "bg-amber-300/60",
          "bg-red-500/60",
          "bg-red-400/55",
          "text-cyan-500/55",
          "text-cyan-300/45",
          "text-emerald-400",
          "text-cyan-400",
          "text-blue-400",
          "text-orange-500",
          "text-blue-500",
          "text-purple-500",
          "text-cyan-500"
        ]
      }
    ],
    "shadcn/no-restyle": [
      "error",
      {
        "allow": ["layout"],
        "contracts": [
          {
            "pattern": "^AccordionContent$",
            "allow": ["layout", "text-muted-foreground"]
          },
          {
            "pattern": "^AnimatedShinyText$",
            "allow": ["layout", "font-semibold", "text-sm"]
          },
          {
            "pattern": "^Badge$",
            "allow": [
              "layout",
              "bg-background/80",
              "bg-discord/10",
              "bg-primary/10",
              "border-dashed",
              "border-transparent",
              "gap-2",
              "px-3",
              "py-1.5",
              "shadow-sm",
              "text-discord",
              "text-discord/50",
              "text-muted-foreground",
              "text-primary",
              "text-sm"
            ]
          },
          {
            "pattern": "^Button$",
            "allow": [
              "layout",
              "backdrop-blur-sm",
              "bg-background/80",
              "bg-black/65",
              "bg-white",
              "border",
              "border-2",
              "border-white/10",
              "font-semibold",
              "gap-2",
              "hover:bg-black/80",
              "hover:bg-offer/10",
              "hover:bg-zinc-200",
              "hover:text-foreground",
              "hover:text-white",
              "px-2",
              "px-8",
              "rounded-full",
              "shadow-none",
              "sm:text-sm",
              "text-lg",
              "text-muted-foreground",
              "text-white",
              "text-xs",
              "text-zinc-950"
            ]
          },
          {
            "pattern": "^Card$",
            "allow": [
              "layout",
              "border-primary",
              "duration-300",
              "gap-4",
              "gap-5",
              "hover:shadow-lg",
              "p-5",
              "p-6",
              "px-6",
              "py-5",
              "ring-2",
              "shadow-lg",
              "transition-all"
            ]
          },
          {
            "pattern": "^CardContent$",
            "allow": ["layout", "spacing"]
          },
          {
            "pattern": "^CardDescription$",
            "allow": ["layout", "typography"]
          },
          {
            "pattern": "^CardFooter$",
            "allow": ["layout", "spacing"]
          },
          {
            "pattern": "^CardHeader$",
            "allow": ["layout", "spacing"]
          },
          {
            "pattern": "^CardTitle$",
            "allow": ["layout", "spacing", "typography", "motion", "color"]
          },
          {
            "pattern": "^CredenzaTitle$",
            "allow": ["layout", "gap-2"]
          },
          {
            "pattern": "^DialogContent$",
            "allow": [
              "layout",
              "bg-black/90",
              "border-white/10",
              "gap-0",
              "p-2",
              "shadow-2xl",
              "sm:p-4"
            ]
          },
          {
            "pattern": "^Empty$",
            "allow": ["layout", "border"]
          },
          {
            "pattern": "^HoverCardContent$",
            "allow": ["layout", "typography"]
          },
          {
            "pattern": "^Input$",
            "allow": ["layout", "bg-fd-background"]
          },
          {
            "pattern": "^NativeSelect$",
            "allow": ["layout", "bg-fd-background"]
          },
          {
            "pattern": "^PaginationNext$",
            "allow": ["layout", "opacity-50"]
          },
          {
            "pattern": "^PaginationPrevious$",
            "allow": ["layout", "opacity-50"]
          },
          {
            "pattern": "^RetroGrid$",
            "allow": ["layout", "opacity-30"]
          },
          {
            "pattern": "^Skeleton$",
            "allow": ["layout", "rounded-full", "rounded-lg", "rounded-xl"]
          },
          {
            "pattern": "^Textarea$",
            "allow": [
              "layout",
              "bg-fd-secondary",
              "placeholder:text-fd-muted-foreground",
              "text-fd-secondary-foreground"
            ]
          },
          {
            "pattern": "^ToggleGroupItem$",
            "allow": [
              "layout",
              "bg-muted",
              "bg-primary",
              "data-pressed:[&_svg]:fill-current",
              "hover:bg-muted/80",
              "px-3",
              "py-1.5",
              "ring-2",
              "ring-current",
              "ring-offset-2",
              "ring-offset-background",
              "ring-primary",
              "rounded-full",
              "text-muted-foreground",
              "text-primary-foreground",
              "text-xs"
            ]
          }
        ]
      }
    ],
    "shadcn/no-unknown-classes": [
      "error",
      {
        "allow": ["not-prose"]
      }
    ],
    "shadcn/require-static-classes": "error",
    "typescript/prefer-readonly-parameter-types": "off",
    "eslint/max-lines": "off",
    "eslint/max-lines-per-function": "off",
    "eslint/max-depth": "off",
    "eslint/max-nested-callbacks": "off",
    "eslint/max-classes-per-file": "off",
    "import/max-dependencies": "off",
    "eslint/no-inline-comments": "off",
    "eslint/no-warning-comments": "off",
    "eslint/no-negated-condition": "off",
    "unicorn/no-negated-condition": "off",
    "eslint/require-await": "off",
    "typescript/strict-boolean-expressions": "off",
    "unicorn/no-useless-undefined": "off"
  },
  "overrides": [
    {
      "files": ["src/components/og/**"],
      "rules": {
        "shadcn/no-inline-styles": "off"
      }
    },
    {
      "files": ["src/routes/**"],
      "rules": {
        "react/only-export-components": "off"
      }
    },
    {
      "files": ["src/lib/discord-embed.ts"],
      "rules": {
        "typescript/no-unsafe-enum-assignment": "off"
      }
    },
    {
      "files": [
        "src/components/cookie-consent-banner.tsx",
        "src/components/feedback.tsx",
        "src/components/item-reviews-section.tsx"
      ],
      "rules": {
        "react/set-state-in-effect": "off"
      }
    },
    {
      "files": ["src/components/home/VoxelScene.tsx"],
      "rules": {
        "react/exhaustive-effect-dependencies": "off"
      }
    }
  ],
  "settings": {
    "better-tailwindcss": {
      "entryPoint": "src/style.css",
      "selectors": [
        {
          "kind": "attribute",
          "name": "^class(?:Name)?$"
        },
        {
          "kind": "attribute",
          "name": "^class(?:Name)?$",
          "match": [
            {
              "type": "strings"
            }
          ]
        },
        {
          "kind": "callee",
          "name": "^cn$",
          "match": [
            {
              "type": "strings"
            },
            {
              "type": "objectKeys"
            }
          ]
        },
        {
          "kind": "callee",
          "name": "^clsx$",
          "match": [
            {
              "type": "strings"
            },
            {
              "type": "objectKeys"
            }
          ]
        },
        {
          "kind": "callee",
          "name": "^twMerge$",
          "match": [
            {
              "type": "strings"
            }
          ]
        },
        {
          "kind": "callee",
          "name": "^cva$",
          "match": [
            {
              "type": "strings"
            },
            {
              "type": "objectValues",
              "path": "^variants.*$"
            },
            {
              "type": "objectValues",
              "path": "^compoundVariants\\[\\d+\\]\\.(?:className|class)$"
            }
          ]
        },
        {
          "kind": "callee",
          "name": "^tv$",
          "match": [
            {
              "type": "strings"
            },
            {
              "type": "objectValues",
              "path": "^(?:base|variants.*|slots.*)$"
            },
            {
              "type": "objectValues",
              "path": "^compound(?:Variants|Slots)\\[\\d+\\]\\.(?:className|class).*$"
            }
          ]
        }
      ]
    }
  }
}
