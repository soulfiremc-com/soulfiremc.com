{
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "vite.config.ts",
    ".cloudflare/types/index.d.ts"
  ],
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "noUncheckedSideEffectImports": true,
    "noUncheckedIndexedAccess": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    // exactOptionalPropertyTypes stays off. It reports about 190 errors, and
    // more than half are in the copied better-auth-ui components. TanStack
    // Form, react-day-picker, Fumadocs, Simple Icons and Vite declare optional
    // props without `| undefined`, so these errors are in framework-typed
    // props that this repository cannot change.
    "paths": {
      "fumadocs-mdx:collections/*": ["./.source/*"],
      "@/*": ["./src/*"]
    }
  },
  "exclude": [
    "node_modules",
    ".next",
    "dist",
    "next-env.d.ts",
    "next.config.ts",
    "open-next.config.ts",
    "load-next-env.ts",
    "load-next-env-direct.ts",
    "auth.loader.ts"
  ]
}
