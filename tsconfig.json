{
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "vite.config.ts",
    ".cloudflare/types/index.d.ts"
  ],
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "noUncheckedSideEffectImports": true,
    "noUncheckedIndexedAccess": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    // exactOptionalPropertyTypes still fails on the copied Better Auth UI
    // registry and framework adapters for TanStack, Fumadocs, Base UI, and
    // other dependencies. Keep it off until those optional props can be
    // passed with the shape their libraries require.
    "paths": {
      "fumadocs-mdx:collections/*": ["./.source/*"],
      "@/*": ["./src/*"]
    }
  },
  "exclude": [
    "node_modules",
    ".next",
    "dist",
    "next-env.d.ts",
    "next.config.ts",
    "open-next.config.ts",
    "load-next-env.ts",
    "load-next-env-direct.ts",
    "auth.loader.ts"
  ]
}
